{
  "name": "financial-planning-platform",
  "version": "2.0.0",
  "description": "Comprehensive financial planning platform with SEPP, 401k, Indian investment calculators, and live financial data",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/financial-planning-platform.git"
  },
  "keywords": [
    "sepp",
    "401k",
    "retirement",
    "calculator",
    "financial",
    "planning",
    "sip",
    "swp",
    "lumpsum",
    "indian",
    "investment",
    "rupee",
    "metals",
    "currency",
    "tax"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "browser-sync start --server --files \"index.html,src/**\" --port 6021 --index index.html --no-open --no-notify",
    "watch": "browser-sync start --server --files \"index.html,src/**\" --port 6021 --ui-port 6022 --index index.html --no-notify",
    "dev": "npm run start",
    "clean": "rm -rf node_modules package-lock.json",
    "fresh-install": "npm run clean && npm install",
    "docker:build": "docker build -t retirement-planning-tools:latest .",
    "docker:run": "docker run --rm -p 6021:80 --name retirement-tools retirement-planning-tools:latest",
    "docker:stop": "docker stop retirement-tools",
    "compose:up": "docker-compose up -d --build",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f",
    "deploy": "npm run compose:up",
    "undeploy": "npm run compose:down"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4"
  },
  "dependencies": {}
}
